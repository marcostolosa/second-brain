# === SecondBrain environment template ===
# Copy to .env (which is git-ignored) OR, preferred on Windows, store the
# TypeSafe token in Windows Credential Manager (see docs\SECURITY.md).
# NEVER commit real secrets. NEVER place secrets in synced Markdown.

# TypeSafe / Jev REST API bearer token.
# Leave blank to force JEV_MODE=mock (deterministic fallback, no network).
TYPESAFE_API_TOKEN=

# Jev operating mode: mock | live
# mock  -> no network, deterministic local routing/dedupe (default & safe)
# live  -> calls the REST API; only after you set a real token AND confirm the endpoint
JEV_MODE=mock

# Optional overrides (otherwise taken from config/config.yaml)
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# Vault root (normally auto-detected as the repo root)
# SECONDBRAIN_ROOT=C:\SecondBrain
